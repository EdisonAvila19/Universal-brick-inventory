{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Brick Inventory",
  "version": "0.1.0",
  "identifier": "com.universalbrick.inventory",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:4321",
    "beforeDevCommand": "npx pnpm@10.18.3 dev",
    "beforeBuildCommand": "npx pnpm@10.18.3 build"
  },
  "app": {
    "windows": [
      {
        "title": "Universal Brick Inventory",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "http://127.0.0.1:4321"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../dist",
      "../node-runtime"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
