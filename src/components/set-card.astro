---
const { set } = Astro.props
const progress = Math.round((set.ownedPieces / set.totalPieces) * 100);
---
<article class="group bg-surface-container-lowest rounded-xl p-4 flex flex-col">
  <div class="relative aspect-square mb-6 overflow-hidden rounded-md bg-surface-container-low">
    <img src={set.image} alt={set.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
    <div class="absolute top-3 left-3 flex gap-2"><span class="bg-primary-container text-[#6a5700] text-[10px] font-black px-2 py-1 rounded-full uppercase tracking-widest">{set.brand}</span>{set.homologatedToLego && <span class="bg-tertiary-container text-on-tertiary-container text-[10px] font-black px-2 py-1 rounded-full uppercase tracking-widest">Homologated</span>}</div>
  </div>
  <p class="text-[10px] font-bold text-secondary uppercase tracking-[0.1em]">Set No. {set.setNumber}</p>
  <h3 class="text-lg font-bold leading-tight mt-1">{set.name}</h3>
  <div class="mt-4 space-y-1">
    <div class="flex justify-between text-[10px] font-bold text-secondary uppercase tracking-widest">
      <span>Completion</span>
      <span>{progress}%</span>
    </div>
    <div class="h-1.5 w-full bg-surface-container-low rounded-full overflow-hidden">
      <div class:list={["h-full", progress === 100 ? "bg-tertiary-container" : "bg-primary-container"]} style={`width:${progress}%`}></div>
    </div>
  </div>
  <div class="pt-4 mt-auto">
    <!-- <div class="flex gap-2 mb-3">
      <a href={`/bricks?set=${encodeURIComponent(set.setNumber)}`} class="flex-1 text-center bg-surface-container-highest text-on-surface text-xs font-bold uppercase tracking-widest px-3 py-2 rounded-lg">Brick Inventory</a>
      <a href={`/shopping?set=${encodeURIComponent(set.setNumber)}`} class="flex-1 text-center bg-surface-container-highest text-on-surface text-xs font-bold uppercase tracking-widest px-3 py-2 rounded-lg">Shopping List</a>
    </div> -->
    <div class="mb-3">
      <a href={`/set-parts?set=${encodeURIComponent(set.setNumber)}`} class="w-full inline-flex justify-center bg-surface-container-highest text-on-surface text-xs font-bold uppercase tracking-widest px-3 py-2 rounded-lg">View/Edit Pieces</a>
    </div>
    <div class="mb-3">
      <a href={`/edit-set?set=${encodeURIComponent(set.setNumber)}`} class="w-full inline-flex justify-center bg-surface-container-highest text-on-surface text-xs font-bold uppercase tracking-widest px-3 py-2 rounded-lg">Edit Set Info</a>
    </div>
    <div class="flex items-center justify-between gap-2">
      <span class="text-xs font-medium text-secondary">{set.totalPieces.toLocaleString()} Pieces</span>
      <form method="post">
        <input type="hidden" name="action" value="delete-set" />
        <input type="hidden" name="setNumber" value={set.setNumber} />
        <button type="submit" class="text-error text-xs font-bold uppercase tracking-widest">Delete Set</button>
      </form>
    </div>
  </div>
</article>