---
import type { ActiveView } from '@/types/archiveData'

interface Props {
  active: ActiveView
}
const { active } = Astro.props;

const nav = [
  { id: "dashboard", href: "/", icon: "dashboard", label: "Dashboard" },
  { id: "bricks", href: "/bricks", icon: "view_in_ar", label: "Brick Inventory" },
  { id: "catalog", href: "/sets", icon: "shelves", label: "Set Catalog" },
  { id: "shopping", href: "/shopping", icon: "shopping_basket", label: "Shopping List" }
];


---

<aside class="hidden md:flex h-screen w-64 fixed left-0 top-0 overflow-y-auto bg-surface-container-low flex-col justify-between py-8 z-20 shadow-[-10px_0_22px_-3px] shadow-contrast">
  <div class="flex flex-col gap-8">
    <div class="px-8">
      <h1 class="text-xl font-black">Bricks Inventory</h1>
    </div>
    <nav class="flex flex-col gap-1">
      {nav.map((item) => (
        <a href={item.href} class:list={[
          "rounded-l-full ml-4 py-3 transition-all flex items-center gap-3 text-sm tracking-tight",
          active === item.id 
            ? "bg-selected text-on-surface font-bold pl-6 shadow-sm" 
            : "text-secondary hover:text-on-surface hover:bg-surface-container-high pl-10"
        ]}>
          <span class="material-symbols-outlined">{item.icon}</span>{item.label}
        </a>
      ))}
    </nav>
    <div class="px-6">
      <a href="/add-set" class={"w-full bg-primary-container text-primary-container-contrast font-bold py-3 rounded-full inline-flex justify-center hover:bg-[#f5d140] hover:shadow-md"}>Catalog New Set</a>
    </div>
  </div>
  <div class="flex flex-col gap-1">
    <button id="theme-toggle" class="text-secondary hover:text-on-surface hover:bg-surface-container-high rounded-l-full ml-4 pl-10 py-3 flex items-center gap-3 transition-colors">
      <span class="material-symbols-outlined" id="theme-icon">dark_mode</span>
      <span id="theme-label">Dark Mode</span>
    </button>
  </div>
</aside>

<script>
  const html = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  const icon = document.getElementById('theme-icon');
  const label = document.getElementById('theme-label');

  function updateUI() {
    const isDark = html.classList.contains('dark');
    icon.textContent = isDark ? 'light_mode' : 'dark_mode';
    label.textContent = isDark ? 'Light Mode' : 'Dark Mode';
  }

  updateUI();

  toggle.addEventListener('click', () => {
    html.classList.toggle('dark');
    const isDark = html.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateUI();
  });
</script>