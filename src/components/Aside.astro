---
import type { ActiveView } from '@/types/archiveData'

interface Props {
  active: ActiveView
}
const { active } = Astro.props;

const nav = [
  { id: "dashboard", href: "/", icon: "dashboard", label: "Dashboard" },
  { id: "bricks", href: "/bricks", icon: "view_in_ar", label: "Brick Inventory" },
  { id: "catalog", href: "/sets", icon: "shelves", label: "Set Catalog" },
  { id: "spare-parts", href: "/spare-parts", icon: "inventory_2", label: "Spare Parts" },
  { id: "shopping", href: "/shopping", icon: "shopping_basket", label: "Shopping List" }
];

const settingsItems = [
  { id: "colors", href: "/colors", icon: "palette", label: "Colors" },
  { id: "design-groups", href: "/design-groups", icon: "category", label: "Design Groups" },
  { id: "categories", href: "/categories", icon: "label", label: "Categories" }
];

const isSettingsActive = active === "colors" || active === "design-groups" || active === "categories";


---

<aside class="hidden md:flex h-screen w-64 fixed left-0 top-0 overflow-y-auto bg-surface-container-low flex-col justify-between py-8 z-20 shadow-[-10px_0_22px_-3px] shadow-contrast">
  <div class="flex flex-col gap-8">
    <div class="px-8">
      <h1 class="text-xl font-black">Bricks Inventory</h1>
    </div>
    <nav class="flex flex-col gap-1">
      {nav.map((item) => (
        <a href={item.href} class:list={[
          "rounded-l-full ml-4 py-3 transition-all flex items-center gap-3 text-sm tracking-tight",
          active === item.id 
            ? "bg-selected text-on-surface font-bold pl-6 shadow-sm" 
            : "text-secondary hover:text-on-surface hover:bg-surface-container-high pl-10"
        ]}>
          <span class="material-symbols-outlined">{item.icon}</span>{item.label}
        </a>
      ))}
    </nav>
    <div class="px-6">
      <a href="/add-set" class={"w-full bg-primary-container text-primary-container-contrast font-bold py-3 rounded-full inline-flex justify-center hover:bg-[#f5d140] hover:shadow-md"}>Catalog New Set</a>
    </div>
  </div>
  <div class="flex flex-col gap-1">
    <div class="relative pe-1.5">
      <button id="settings-toggle" aria-expanded={isSettingsActive} class:list={[
        "w-full rounded-l-full ml-4 py-3 transition-all flex items-center gap-3 text-sm tracking-tight",
        isSettingsActive 
          ? "bg-selected text-on-surface font-bold pl-6 shadow-sm" 
          : "text-secondary hover:text-on-surface hover:bg-surface-container-high pl-10"
      ]}>
        <span class="material-symbols-outlined">settings</span>
        <span class="flex-1 text-left">Settings</span>
        <span id="settings-chevron" class:list={["material-symbols-outlined", "text-lg", "mr-4", "transition-transform", { "rotate-180": isSettingsActive }]}>expand_more</span>
      </button>
      <div id="settings-submenu" class:list={["absolute bottom-full left-4 right-0 mb-2 bg-surface-container-lowest rounded-xl shadow-lg p-2 space-y-1", { hidden: !isSettingsActive }]}>
        {settingsItems.map((item) => (
          <a href={item.href} class:list={[
            "flex items-center gap-3 text-sm tracking-tight rounded-lg px-3 py-2 transition-colors",
            active === item.id 
              ? "bg-selected text-on-surface font-bold shadow-sm" 
              : "text-secondary hover:text-on-surface hover:bg-surface-container-high"
          ]}>
            <span class="material-symbols-outlined text-lg">{item.icon}</span>{item.label}
          </a>
        ))}
      </div>
    </div>
    <button id="theme-toggle" class="text-secondary hover:text-on-surface hover:bg-surface-container-high rounded-l-full ml-4 pl-10 py-3 flex items-center gap-3 transition-colors">
      <span class="material-symbols-outlined" id="theme-icon">dark_mode</span>
      <span id="theme-label">Dark Mode</span>
    </button>
  </div>
</aside>

<script>
  const html = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  const icon = document.getElementById('theme-icon');
  const label = document.getElementById('theme-label');

  function updateUI() {
    const isDark = html.classList.contains('dark');
    icon.textContent = isDark ? 'light_mode' : 'dark_mode';
    label.textContent = isDark ? 'Light Mode' : 'Dark Mode';
  }

  updateUI();

  toggle.addEventListener('click', () => {
    html.classList.toggle('dark');
    const isDark = html.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateUI();
  });

  const settingsToggle = document.getElementById('settings-toggle');
  const settingsSubmenu = document.getElementById('settings-submenu');
  const settingsChevron = document.getElementById('settings-chevron');

  if (settingsToggle && settingsSubmenu && settingsChevron) {
    settingsToggle.addEventListener('click', () => {
      const isOpen = !settingsSubmenu.classList.toggle('hidden');
      settingsToggle.setAttribute('aria-expanded', String(isOpen));
      settingsChevron.classList.toggle('rotate-180');
    });
  }
</script>