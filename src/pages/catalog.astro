---
import AppLayout from "@layouts/AppLayout.astro";
import SetCard  from "@components/Set-card.astro";
import { deleteSetFromInventory, getInventorySets } from "@lib/inventoryStore";

const url = new URL(Astro.request.url);
const brandFilter = url.searchParams.get("brand") ?? "all";

let feedback = "";
let feedbackTone: "ok" | "error" = "ok";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  if (String(formData.get("action") ?? "") === "delete-set") {
    const setNumber = String(formData.get("setNumber") ?? "");
    const result = await deleteSetFromInventory(setNumber);
    if (result.removed) {
      feedback = `Set ${setNumber} removed from inventory.`;
    } else {
      feedbackTone = "error";
      feedback = "Could not remove set.";
    }
  }
}

const allSets = await getInventorySets();
const sets = allSets.filter((set) => brandFilter === "all" || (brandFilter === "lego" ? set.brand === "LEGO" : set.brand !== "LEGO"));
const totalSets = sets.length;
const completion = totalSets === 0 ? 0 : Math.round(sets.reduce((acc, set) => acc + Math.round((set.ownedPieces / set.totalPieces) * 100), 0) / totalSets);
---

<AppLayout title="Bricks Inventory | Set Catalog" active="catalog">
  <!-- Header -->
  <header class="flex flex-col md:flex-row justify-between items-end gap-6 mb-10">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary mb-2">Your Collection</p>
      <h1 class="text-4xl md:text-5xl font-black tracking-tighter">Set Catalog</h1>
    </div>
    <div class="flex items-center gap-8 text-right">
      <div><p class="text-[0.65rem] font-bold text-secondary uppercase tracking-widest mb-1">Total Sets</p><p class="text-4xl font-black tracking-tighter">{totalSets}</p></div>
      <div class="h-12 w-px bg-outline-variant opacity-20"></div>
      <div><p class="text-[0.65rem] font-bold text-secondary uppercase tracking-widest mb-1">Completion</p><p class="text-4xl font-black tracking-tighter">{completion}%</p></div>
    </div>
  </header>

  <!-- Feedback message -->
  {feedback && <p class:list={["mb-6 rounded-lg p-3 text-sm font-medium", feedbackTone === "error" ? "bg-error-container text-on-error-container" : "bg-tertiary-container text-on-tertiary-container"]}>{feedback}</p>}

  <!-- Filters -->
  <section class="flex flex-wrap items-center gap-4 mb-8">
    <a href="/catalog?brand=all" class:list={["px-6 py-2 rounded-full text-xs font-bold tracking-wide", brandFilter === "all" ? "bg-on-surface text-white" : "bg-white text-secondary"]}>All Brands</a>
    <a href="/catalog?brand=lego" class:list={["px-6 py-2 rounded-full text-xs font-bold tracking-wide", brandFilter === "lego" ? "bg-on-surface text-white" : "bg-white text-secondary"]}>Lego Only</a>
    <a href="/catalog?brand=third-party" class:list={["px-6 py-2 rounded-full text-xs font-bold tracking-wide", brandFilter === "third-party" ? "bg-on-surface text-white" : "bg-white text-secondary"]}>Third Party</a>
  </section>

  {sets.length === 0 ? (
    <section class="bg-surface-container-lowest rounded-xl p-12 text-center text-secondary">
      <h2 class="text-2xl font-black mb-2">No sets in catalog</h2>
      <p class="text-sm">Start by adding one in <a href="/add-set" class="text-primary font-bold">Catalog New Set</a>.</p>
    </section>
  ) : (
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sets.map((set) => <SetCard set={set} />)}
    </section>
  )}
</AppLayout>
