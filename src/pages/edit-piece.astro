---
import AppLayout from "../layouts/AppLayout.astro";
import { getInventoryBricks, updateBrickInSet } from "../lib/inventoryStore";

const url = new URL(Astro.request.url);
const queryFromSet = (url.searchParams.get("fromSet") ?? "").trim();
const queryReference = (url.searchParams.get("reference") ?? "").trim();
const queryColor = (url.searchParams.get("color") ?? "").trim();

let activeFromSet = queryFromSet;
let activeReference = queryReference;
let activeColor = queryColor;
let feedback = "";
let feedbackTone: "ok" | "error" = "ok";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const fromSet = String(formData.get("fromSet") ?? "").trim();
  const originalReference = String(formData.get("originalReference") ?? "").trim();
  const originalColor = String(formData.get("originalColor") ?? "").trim();
  const reference = String(formData.get("reference") ?? "").trim();
  const color = String(formData.get("color") ?? "").trim();

  const result = await updateBrickInSet({
    fromSet,
    originalReference,
    originalColor,
    reference,
    name: String(formData.get("name") ?? "").trim(),
    color,
    colorHex: String(formData.get("colorHex") ?? "#000000").trim(),
    image: String(formData.get("image") ?? "").trim(),
    required: Number(formData.get("required") ?? 1),
    stock: Number(formData.get("stock") ?? 0)
  });

  if (!result.updated) {
    feedbackTone = "error";
    if (result.reason === "duplicate-piece") feedback = "Another piece in this set already uses that reference and color.";
    else if (result.reason === "piece-not-found") feedback = "Piece not found.";
    else feedback = "Could not update piece. Check the form values.";
    activeFromSet = fromSet;
    activeReference = originalReference || reference;
    activeColor = originalColor || color;
  } else {
    feedback = "Piece updated successfully.";
    activeFromSet = fromSet;
    activeReference = reference;
    activeColor = color;
  }
}

const allBricks = await getInventoryBricks();
const selectedBrick = allBricks.find((brick) => brick.fromSet === activeFromSet && brick.reference.toLowerCase() === activeReference.toLowerCase() && brick.color.toLowerCase() === activeColor.toLowerCase()) ?? null;
---

<AppLayout title="Bricks Inventory | Edit Piece" active="bricks">
  <section class="mb-10">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary mb-2">Piece Metadata</p>
    <h1 class="text-4xl font-black tracking-tight">Edit Piece Information</h1>
  </section>

  {feedback && <p class:list={["mb-6 rounded-lg p-3 text-sm font-medium", feedbackTone === "error" ? "bg-error-container text-on-error-container" : "bg-tertiary-container text-on-tertiary-container"]}>{feedback}</p>}

  {!activeFromSet || !activeReference || !activeColor ? (
    <section class="bg-surface-container-lowest rounded-xl p-12 text-center text-secondary">
      <h2 class="text-2xl font-black mb-2">Select a piece from Brick Inventory</h2>
      <p class="text-sm">Open this page from the <a href="/bricks" class="font-bold underline">Brick Inventory</a> card action.</p>
    </section>
  ) : !selectedBrick ? (
    <section class="bg-error-container text-on-error-container rounded-xl p-6">
      <h2 class="text-xl font-black mb-2">Piece not found</h2>
      <p class="text-sm">The selected piece does not exist. Go back to <a href="/bricks" class="font-bold underline">Brick Inventory</a>.</p>
    </section>
  ) : (
    <section class="bg-surface-container-lowest rounded-xl p-6">
      <div class="flex flex-col md:flex-row gap-6 mb-6">
        <img src={selectedBrick.image} alt={selectedBrick.name} class="w-32 h-32 object-contain rounded-lg bg-surface-container-low p-2" />
        <div class="space-y-2">
          <p class="text-[10px] font-bold uppercase tracking-widest text-secondary">Ref. {selectedBrick.reference}</p>
          <h2 class="text-2xl font-black leading-tight">{selectedBrick.name}</h2>
          <p class="text-sm text-secondary">{selectedBrick.color} · From set {selectedBrick.fromSet}</p>
        </div>
      </div>

      <form method="post" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <input type="hidden" name="fromSet" value={selectedBrick.fromSet} />
        <input type="hidden" name="originalReference" value={selectedBrick.reference} />
        <input type="hidden" name="originalColor" value={selectedBrick.color} />

        <div>
          <label class="block text-[10px] uppercase font-bold text-secondary mb-1">Reference</label>
          <input required name="reference" value={selectedBrick.reference} class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-[10px] uppercase font-bold text-secondary mb-1">Name</label>
          <input required name="name" value={selectedBrick.name} class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-[10px] uppercase font-bold text-secondary mb-1">Color</label>
          <input required name="color" value={selectedBrick.color} class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-[10px] uppercase font-bold text-secondary mb-1">Color Hex</label>
          <input name="colorHex" value={selectedBrick.colorHex} class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" />
        </div>
        <div class="md:col-span-2">
          <label class="block text-[10px] uppercase font-bold text-secondary mb-1">Image URL</label>
          <input type="url" name="image" value={selectedBrick.image} class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-[10px] uppercase font-bold text-secondary mb-1">Required</label>
          <input required min="1" type="number" name="required" value={selectedBrick.required} class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-[10px] uppercase font-bold text-secondary mb-1">Stock</label>
          <input required min="0" type="number" name="stock" value={selectedBrick.stock} class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" />
        </div>
        <div class="md:col-span-2 flex gap-2">
          <button type="submit" class="bg-primary text-white px-6 py-3 rounded-lg font-bold text-sm">Save Piece Info</button>
          <a href="/bricks" class="bg-surface-container-highest text-on-surface px-6 py-3 rounded-lg font-bold text-sm">Back to Brick Inventory</a>
        </div>
      </form>
    </section>
  )}
</AppLayout>
