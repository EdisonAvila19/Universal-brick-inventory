---
import AppLayout from "@layouts/AppLayout.astro";
import { getInventorySets } from "@lib/inventoryStore";
import { SetsResults } from '@/components/Sets-results'
import { Feedback } from '@/components/Feedback';
import BrandSetsFilters from '@/components/BrandSetsFilters'
import SetsCounterIndicator from '@/components/SetsCounterIndicator'

const url = new URL(Astro.request.url);
const brandFilter = url.searchParams.get("brand") ?? "all";
const searchFilter = url.searchParams.get("search") ?? "";

const allSets = await getInventorySets();
---

<AppLayout title="Bricks Inventory | Set Catalog" active="catalog">
  <!-- Header -->
  <header class="flex flex-col md:flex-row justify-between items-end gap-6 mb-10">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary mb-2">Your Collection</p>
      <h1 class="text-4xl md:text-5xl font-black tracking-tighter">Set Catalog</h1>
    </div>
    <div class="flex items-center gap-8 text-right">
      <SetsCounterIndicator client:load/>
    </div>
  </header>

  <!-- Feedback message -->
  <Feedback client:load/>

  <!-- Filters -->
  <BrandSetsFilters client:load/>

  <!-- Sets List -->
  <SetsResults initialSets={allSets} initialFilters={{ brand: brandFilter, search: searchFilter }} client:load/>
</AppLayout>
