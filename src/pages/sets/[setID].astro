---
import AppLayout from "@layouts/AppLayout.astro";
import { getInventoryBricks, getInventoryBricksSet, getInventorySets } from "@lib/inventoryStore";
import { Feedback } from "@components/Feedback";
import SetsSelect from "@components/SetsSelect";
import SetInfo from "@components/SetInfo";
import AddNewPiece from '@/components/AddNewPiece'

const { setID: querySetNumber } = Astro.params;

let activeSetNumber = querySetNumber || "";

const allSets = await getInventorySets();
const bricks = await getInventoryBricksSet(activeSetNumber);
const allBricks = await getInventoryBricks();

const selectedSet = allSets.find((set) => set.setNumber === activeSetNumber) ?? null;
---

<AppLayout title="Bricks Inventory | Edit Set" active="catalog">

  <section class="mb-10">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary mb-2">Set Metadata</p>
    <h1 class="text-4xl font-black tracking-tight">Edit Set Information</h1>
  </section>

  <!-- Filter -->
  <SetsSelect initialSets={allSets} activeSetNumber={activeSetNumber} client:load/>
  
  <!-- Feedback -->
  <Feedback client:load/>

  <!-- Result -->
  { selectedSet
    ? (
      <SetInfo activeSetNumber={activeSetNumber} initialSelectedSet={selectedSet} initialSetBricks={bricks} client:load/>

      <AddNewPiece selectedSet={selectedSet} allBricks={allBricks} client:load/>
    )
    : (
      <section class="bg-error-container text-on-error-container rounded-xl p-6">
        <h2 class="text-xl font-black mb-2">Set not found</h2>
        <p class="text-sm">The selected set does not exist in inventory. Go back to <a href="/sets" class="font-bold underline">Set Catalog</a> or select another set in the list.</p>
      </section>
    )
  }
</AppLayout>