---
import AppLayout from "@layouts/AppLayout.astro";
import { getColors } from "@lib/inventoryStore";
import { Feedback } from "@components/Feedback";
import ColorManager from "@/components/ColorManager";

const colors = await getColors();
---

<AppLayout title="Colors | Brick Inventory" active="colors">
  <Feedback client:load />

  <section class="mb-10 flex flex-col md:flex-row justify-between items-end gap-6">
    <div>
      <h1 class="text-4xl font-black tracking-tight mb-2">Colors</h1>
      <p class="text-secondary font-medium uppercase text-xs tracking-[0.2em]">Manage color palette</p>
    </div>
    <div class="text-right">
      <p class="font-black text-2xl">{colors.length}</p>
      <p class="text-secondary font-medium uppercase text-xs tracking-[0.2em]">Total Colors</p>
    </div>
  </section>

  <ColorManager initialColors={colors} client:load />
</AppLayout>
