---
import AppLayout from "@layouts/AppLayout.astro";
import { Feedback }  from "@components/Feedback";
import AddSetForm from '@/components/AddSetForm'
---

<AppLayout title="Bricks Inventory | Add Set" active="">
  <Feedback client:load/>

  <section class="mb-10">
    <h1 class="text-4xl font-black tracking-tight mb-2">Catalog New Set</h1>
    <p class="text-secondary">Add LEGO sets from Rebrickable or add compatible brand sets manually.</p>
  </section>

  <AddSetForm client:load/>
</AppLayout>
