---
import AppLayout from "../layouts/AppLayout.astro";
import { addBrickToSet, getColors, getInventoryBricks, getInventorySets, removeBrickFromSet, updateBrickInSet } from "../lib/inventoryStore";
import { fetchRebrickablePart, fetchRebrickablePartColors, type RebrickablePartColorDetails } from "../lib/rebrickable";

const url = new URL(Astro.request.url);
const querySetNumber = (url.searchParams.get("set") ?? "").trim();

let feedback = "";
let feedbackTone: "ok" | "error" = "ok";

const allSets = await getInventorySets();
const allBricks = await getInventoryBricks();

const existingBrickLookup = new Map<string, (typeof allBricks)[number]>();
for (const brick of allBricks) {
  if (!existingBrickLookup.has(brick.elementId)) existingBrickLookup.set(brick.elementId, brick);
}

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = String(formData.get("action") ?? "");
  const setNumber = String(formData.get("setNumber") ?? querySetNumber).trim();

  try {
    if (!setNumber) {
      throw new Error("Set number is required.");
    }

    if (action === "search-external-part") {
      const partNum = String(formData.get("reference") ?? "").trim();
      if (!partNum) {
        feedbackTone = "error";
        feedback = "Please enter a part number to search.";
      } else {
        try {
          const partDetails = await fetchRebrickablePart(partNum);
          const partColors = await fetchRebrickablePartColors(partNum);
          const localColors = await getColors();
          
          if (partColors.length === 0) {
            feedbackTone = "error";
            feedback = "Part found, but no colors available.";
          } else {
            // console.log(localColors);
            
            // console.log(partColors[0]);
            
            const enrichedColors = partColors
              .filter(pc => pc && typeof pc.color_id === 'number')
              .map(pc => {
                const localColor = localColors.find(lc => lc.id === pc.color_id);
                return {
                  ...pc,
                  colorRgb: localColor ? localColor.rgb : (pc.color?.rgb || '000000')
                };
              });
            
            Astro.locals.externalPart = {
              part: partDetails,
              colors: enrichedColors
            };
            console.log(Astro.locals.externalPart)
            feedback = `Part "${partDetails.name}" found! Select a color below.`;
          }
        } catch (err) {
          console.error("Rebrickable API error:", err);
          feedbackTone = "error";
          feedback = `Error searching part: ${err instanceof Error ? err.message : "Unknown error"}`;
        }
      }
    }

    if (action === "add-brick") {
      const existingElementId = String(formData.get("existingElementId") ?? "").trim();
      const existingBrick = existingBrickLookup.get(existingElementId);
      const colorId = existingBrick?.colorId ?? Number(formData.get("colorId") ?? "0");
      const result = await addBrickToSet({
        fromSet: setNumber,
        elementId: existingBrick?.elementId ?? `${String(formData.get("reference") ?? "").trim()}-${colorId}`,
        reference: existingBrick?.reference ?? String(formData.get("reference") ?? "").trim(),
        name: existingBrick?.name ?? String(formData.get("name") ?? "").trim(),
        colorId: colorId,
        image: existingBrick?.image ?? String(formData.get("image") ?? "").trim(),
        required: Number(formData.get("required") ?? 1),
        stock: Number(formData.get("stock") ?? 0)
      });
      if (!result.added) {
        feedbackTone = "error";
        if (result.reason === "duplicate-piece") feedback = "This piece already exists in the set.";
        else if (result.reason === "set-not-found") feedback = "Set not found in inventory.";
        else feedback = "Could not add piece. Check the form values.";
      } else {
        feedback = "Piece added successfully.";
      }
    }

    if (action === "update-brick") {
      const result = await updateBrickInSet({
        fromSet: setNumber,
        originalElementId: String(formData.get("originalElementId") ?? "").trim(),
        elementId: String(formData.get("elementId") ?? "").trim(),
        reference: String(formData.get("reference") ?? "").trim(),
        name: String(formData.get("name") ?? "").trim(),
        colorId: Number(formData.get("colorId") ?? "0"),
        image: String(formData.get("image") ?? "").trim(),
        required: Number(formData.get("required") ?? 1),
        stock: Number(formData.get("stock") ?? 0)
      });
      if (!result.updated) {
        feedbackTone = "error";
        if (result.reason === "duplicate-piece") feedback = "Another piece already uses that ID in this set.";
        else if (result.reason === "piece-not-found") feedback = "Piece not found.";
        else feedback = "Could not update piece. Check the form values.";
      } else {
        feedback = "Piece updated successfully.";
      }
    }

    if (action === "remove-brick") {
      const result = await removeBrickFromSet({
        fromSet: setNumber,
        elementId: String(formData.get("elementId") ?? "").trim()
      });
      if (!result.removed) {
        feedbackTone = "error";
        feedback = "Could not remove piece.";
      } else {
        feedback = "Piece removed successfully.";
      }
    }
  } catch (error) {
    feedbackTone = "error";
    feedback = error instanceof Error ? error.message : "Unknown error";
  }
}

let finalBricks = allBricks;
let finalLookup = existingBrickLookup;

if (Astro.request.method === "POST") {
  finalBricks = await getInventoryBricks();
  finalLookup = new Map<string, (typeof finalBricks)[number]>();
  for (const brick of finalBricks) {
    if (!finalLookup.has(brick.elementId)) finalLookup.set(brick.elementId, brick);
  }
}

const selectedSet = allSets.find((set) => set.setNumber === querySetNumber) ?? null;
const selectedSetBricks = selectedSet
  ? finalBricks
      .filter((brick) => brick.fromSet === selectedSet.setNumber)
      .map((brick) => {
        const record: Record<string, unknown> = brick as any;
        return {
          ...brick,
          colorName: String(record.colorName ?? "Unknown"),
          colorHex: String(record.colorHex ?? "#000000")
        };
      })
      .sort((left, right) => left.elementId.localeCompare(right.elementId))
  : [];
const selectableExistingBricks = selectedSet
  ? Array.from(finalLookup.values())
      .filter((brick) => brick.fromSet !== selectedSet.setNumber)
      .map((brick) => {
        const record: Record<string, unknown> = brick as any;
        return {
          ...brick,
          colorName: String(record.colorName ?? "Unknown"),
          colorHex: String(record.colorHex ?? "#000000")
        };
      })
      .sort((left, right) => left.elementId.localeCompare(right.elementId))
  : [];
const totalRequired = selectedSetBricks.reduce((acc, brick) => acc + brick.required, 0);
const totalOwned = selectedSetBricks.reduce((acc, brick) => acc + Math.min(brick.required, brick.stock), 0);
---

<AppLayout title="Bricks Inventory | Set Pieces" active="catalog">
  <section class="mb-10">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary mb-2">Set Composition</p>
    <h1 class="text-4xl font-black tracking-tight">View and Edit Set Pieces</h1>
  </section>

  <section class="bg-surface-container-low rounded-xl p-6 mb-6">
    <form method="get" class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-4 items-end">
      <div>
        <label class="block text-[10px] uppercase font-bold text-secondary mb-2 px-2">Select Set</label>
        <select name="set" class="w-full bg-surface-container-highest border-none rounded-lg px-4 py-3 text-sm">
          <option value="">Choose a set</option>
          {allSets.map((set) => <option value={set.setNumber} selected={set.setNumber === querySetNumber}>{set.setNumber} — {set.name}</option>)}
        </select>
      </div>
      <button type="submit" class="bg-on-surface text-white px-6 py-3 rounded-lg font-bold text-sm">Open Set</button>
    </form>
  </section>

        <div id="feedback-msg" class:list={["fixed top-4 left-1/2 -translate-x-1/2 z-50 max-w-2xl w-full mx-auto px-4 rounded-lg p-4 text-sm font-medium shadow-lg transition-all duration-300", feedback ? "opacity-100 visible" : "opacity-0 invisible", feedbackTone === "error" ? "bg-error-container text-on-error-container" : "bg-tertiary-container text-on-tertiary-container"]}>
          <div class="flex items-center justify-between gap-4">
            <span>{feedback}</span>
            <button type="button" onclick="document.getElementById('feedback-msg').classList.add('opacity-0', 'invisible')" class="text-lg leading-none font-bold opacity-70 hover:opacity-100 transition-opacity">&times;</button>
          </div>
        </div>

  {!querySetNumber ? (
    <section class="bg-surface-container-lowest rounded-xl p-12 text-center text-secondary">
      <h2 class="text-2xl font-black mb-2">Select a set to continue</h2>
      <p class="text-sm">Pick a set above to review and edit its pieces.</p>
    </section>
  ) : !selectedSet ? (
    <section class="bg-error-container text-on-error-container rounded-xl p-6">
      <h2 class="text-xl font-black mb-2">Set not found</h2>
      <p class="text-sm">The selected set does not exist in inventory. Go back to <a href="/catalog" class="font-bold underline">Set Catalog</a>.</p>
    </section>
  ) : (
    <>
      <section class="bg-surface-container-lowest rounded-xl p-6 mb-8">
        <div class="flex flex-col md:flex-row gap-6">
          <img src={selectedSet.image} alt={selectedSet.name} class="w-32 h-32 object-cover rounded-lg bg-surface-container-low" />
          <div class="space-y-2">
            <p class="text-[10px] font-bold uppercase tracking-widest text-secondary">Set No. {selectedSet.setNumber}</p>
            <h2 class="text-2xl font-black leading-tight">{selectedSet.name}</h2>
            <p class="text-sm text-secondary">{selectedSet.brand} · {selectedSet.source === "rebrickable" ? "Imported from Rebrickable" : "Manual set"}</p>
            <p class="text-sm text-secondary">Unique pieces: <span class="font-bold text-on-surface">{selectedSetBricks.length}</span> · Required units: <span class="font-bold text-on-surface">{totalRequired.toLocaleString()}</span> · Owned units: <span class="font-bold text-on-surface">{totalOwned.toLocaleString()}</span></p>
          </div>
        </div>
      </section>

      <div id="brick-list">
      {selectedSetBricks.length === 0 ? (
        <section class="bg-surface-container-lowest rounded-xl p-8 text-center text-secondary mb-8">
          <h3 class="text-xl font-black mb-2">No pieces in this set yet</h3>
          <p class="text-sm">Use the form below to add your first piece.</p>
        </section>
      ) : (
        <section class="space-y-4 mb-10">
          {selectedSetBricks.map((brick) => (
            <article class="bg-surface-container-lowest rounded-xl p-5">
              <div class="flex flex-col lg:flex-row gap-4 lg:items-center">
                <div class="flex gap-4 min-w-0 lg:flex-1">
                  <img src={brick.image} alt={brick.name} class="w-16 h-16 rounded-lg bg-surface-container-low object-contain p-2" />
                  <div class="min-w-0"><p class="text-[10px] font-bold uppercase tracking-widest text-secondary">Ref. {brick.reference}</p><p class="text-[9px] font-semibold text-tertiary tracking-wider">ID: {brick.elementId}</p><h3 class="font-black text-base leading-tight truncate">{brick.name}</h3><p class="text-xs text-secondary">{brick.colorName} · <span class="inline-block w-3 h-3 rounded" style={`background:${brick.colorHex}`}></span></p></div>
                </div>
                <form method="post" class="grid grid-cols-2 md:grid-cols-4 gap-2 lg:items-end">
                  <input type="hidden" name="action" value="update-brick" />
                  <input type="hidden" name="setNumber" value={selectedSet.setNumber} />
                  <input type="hidden" name="originalElementId" value={brick.elementId} />
                  <input type="hidden" name="elementId" value={brick.elementId} />
                  <input type="hidden" name="reference" value={brick.reference} />
                  <input type="hidden" name="name" value={brick.name} />
                  <input type="hidden" name="colorId" value={brick.colorId} />
                  <input type="hidden" name="image" value={brick.image} />
                  <div><label class="block text-[10px] uppercase font-bold text-secondary mb-1">Required</label><input required min="1" type="number" name="required" value={brick.required} class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" /></div>
                  <div><label class="block text-[10px] uppercase font-bold text-secondary mb-1">Stock</label><input required min="0" type="number" name="stock" value={brick.stock} class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" /></div>
                  <button type="submit" class="bg-primary text-white px-3 py-2 rounded-lg text-xs font-bold uppercase tracking-widest">Save Qty</button>
                </form>
                <form method="post" class="lg:ml-2">
                  <input type="hidden" name="action" value="remove-brick" />
                  <input type="hidden" name="setNumber" value={selectedSet.setNumber} />
                  <input type="hidden" name="elementId" value={brick.elementId} />
                  <button type="submit" class="text-error text-xs font-bold uppercase tracking-widest">Remove Piece</button>
                </form>
              </div>
              <details class="mt-4"><summary class="cursor-pointer text-xs font-bold uppercase tracking-widest text-secondary">Edit Piece Details</summary><form method="post" class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-3"><input type="hidden" name="action" value="update-brick" /><input type="hidden" name="setNumber" value={selectedSet.setNumber} /><input type="hidden" name="originalElementId" value={brick.elementId} /><input type="hidden" name="elementId" value={brick.elementId} /><div><label class="block text-[10px] uppercase font-bold text-secondary mb-1">Reference</label><input required name="reference" value={brick.reference} class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" /></div><div><label class="block text-[10px] uppercase font-bold text-secondary mb-1">Name</label><input required name="name" value={brick.name} class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" /></div><div><label class="block text-[10px] uppercase font-bold text-secondary mb-1">Color</label><input required name="color" value={brick.color} class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" /></div><div><label class="block text-[10px] uppercase font-bold text-secondary mb-1">Color Hex</label><input name="colorHex" value={brick.colorHex} class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" /></div><div class="md:col-span-2"><label class="block text-[10px] uppercase font-bold text-secondary mb-1">Image URL</label><input type="url" name="image" value={brick.image} class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" /></div><div><label class="block text-[10px] uppercase font-bold text-secondary mb-1">Required</label><input required min="1" type="number" name="required" value={brick.required} class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" /></div><div><label class="block text-[10px] uppercase font-bold text-secondary mb-1">Stock</label><input required min="0" type="number" name="stock" value={brick.stock} class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" /></div><div class="md:col-span-2"><button type="submit" class="bg-primary text-white px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-widest">Save Details</button></div></form></details>
            </article>
          ))}
        </section>
      )}
      </div>

      {Astro.locals.externalPart && (
        <section class="bg-surface-container-highest rounded-xl p-6 mb-6">
          <h4 class="text-lg font-black mb-2">External Part Found</h4>
          <div class="flex gap-4 items-start mb-4">
            <img src={Astro.locals.externalPart.part.part_img_url ?? "https://images.unsplash.com/photo-1587654780291-39c9404d746b?auto=format&fit=crop&w=900&q=80"} alt={Astro.locals.externalPart.part.name} class="w-24 h-24 object-contain bg-surface-container-low p-2 rounded-lg" />
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-secondary">Ref. {Astro.locals.externalPart.part.part_num}</p>
              <h5 class="font-black text-base">{Astro.locals.externalPart.part.name}</h5>
              <p class="text-xs text-secondary">Select a color to add:</p>
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
            {Astro.locals.externalPart.colors
              .map((colorData: RebrickablePartColorDetails) => (
              <form method="post" class="bg-surface-container-lowest p-3 rounded-lg flex items-center gap-3">
                <input type="hidden" name="action" value="add-brick" />
                <input type="hidden" name="setNumber" value={selectedSet?.setNumber} />
                <input type="hidden" name="reference" value={Astro.locals.externalPart.part.part_num} />
                <input type="hidden" name="name" value={Astro.locals.externalPart.part.name} />
                <input type="hidden" name="colorId" value={colorData.color_id} />
                <input type="hidden" name="elementId" value={(colorData.elements && colorData.elements[0]) ? colorData.elements[0] : `${Astro.locals.externalPart.part.part_num}-${colorData.color_id}`} />
                <input type="hidden" name="image" value={colorData.part_img_url ?? ""} />
                <div class="w-6 h-6 rounded-full shadow-inner" style={`background:${colorData.colorRgb}`}></div>
                <div class="flex-1">
                  <p class="text-xs font-bold">{colorData.color_name}</p>
                  <p class="text-[9px] text-secondary">ID: {(colorData.elements && colorData.elements[0]) ? colorData.elements[0] : "N/A"}</p>
                </div>
                <button type="submit" class="bg-primary text-white px-3 py-1 rounded text-xs font-bold">Add</button>
              </form>
            ))}
          </div>
        </section>
      )}

       <section class="bg-surface-container-low rounded-xl p-6">
         <h3 class="text-xl font-black mb-4">Add Piece to Set</h3>
         
         <form method="post" class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
           <input type="hidden" name="action" value="search-external-part" />
           <input type="hidden" name="setNumber" value={selectedSet.setNumber} />
           <div class="md:col-span-2"><label class="block text-[10px] uppercase font-bold text-secondary mb-1">Search External Part (Rebrickable)</label><input name="reference" placeholder="Enter part number (e.g. 3001)" class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" /></div>
           <div class="md:col-span-2"><button type="submit" class="bg-tertiary text-on-tertiary px-6 py-3 rounded-lg font-bold text-sm">Search Part</button></div>
         </form>

         <form method="post" class="grid grid-cols-1 md:grid-cols-2 gap-4" id="add-brick-form">
           <input type="hidden" name="action" value="add-brick" />
           <input type="hidden" name="setNumber" value={selectedSet.setNumber} />
           <div class="md:col-span-2"><label class="block text-[10px] uppercase font-bold text-secondary mb-1">Search Existing Piece</label><input name="existingElementId" list="existing-bricks" placeholder="Search by typing reference or color" class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" /><datalist id="existing-bricks">{selectableExistingBricks.map((brick) => <option value={brick.elementId}>{brick.reference} · {brick.colorName} · {brick.name}</option>)}</datalist></div>
           <div id="manual-fields" style="display: contents;">
             <div><label class="block text-[10px] uppercase font-bold text-secondary mb-1">Reference</label><input name="reference" class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" /></div>
             <div><label class="block text-[10px] uppercase font-bold text-secondary mb-1">Name</label><input name="name" class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" /></div>
             <div><label class="block text-[10px] uppercase font-bold text-secondary mb-1">Color ID</label><input type="number" name="colorId" class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" /></div>
             <div class="md:col-span-2"><label class="block text-[10px] uppercase font-bold text-secondary mb-1">Image URL</label><input type="url" name="image" placeholder="https://..." class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" /></div>
           </div>
           <div id="existing-preview" class="md:col-span-2" style="display:none;"></div>
           <div><label class="block text-[10px] uppercase font-bold text-secondary mb-1">Required</label><input required min="1" type="number" name="required" value="1" class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" /></div>
           <div><label class="block text-[10px] uppercase font-bold text-secondary mb-1">Stock</label><input required min="0" type="number" name="stock" value="0" class="w-full bg-surface-container-highest border-none rounded-lg px-3 py-2 text-sm" /></div>
           <div class="md:col-span-2"><button type="submit" class="bg-primary text-white px-6 py-3 rounded-lg font-bold text-sm">Add Piece</button></div>
         </form>
       </section>
    </>
  )}
</AppLayout>

<script define:vars={{ selectableExistingBricks: JSON.stringify(selectableExistingBricks), querySetNumber }}>
  const bricks = JSON.parse(selectableExistingBricks);
  const brickLookup = new Map(bricks.map(b => [b.elementId, b]));

  const input = document.querySelector('input[name="existingElementId"]');
  const manualFields = document.getElementById('manual-fields');
  const preview = document.getElementById('existing-preview');

  if (input && manualFields && preview) {
    input.addEventListener('input', () => {
      const brick = brickLookup.get(input.value);
      if (brick) {
        manualFields.style.display = 'none';
        preview.style.display = 'block';
        const colorName = brick.colorName ?? "Unknown";
        const colorHex = brick.colorHex ?? "#000000";
        preview.innerHTML = `
          <div class="bg-surface-container-highest rounded-lg p-4 flex gap-4 items-center">
            <img src="${brick.image}" alt="${brick.name}" class="w-16 h-16 rounded-lg object-contain p-2 bg-surface-container-low" />
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-secondary">Ref. ${brick.reference}</p>
              <h4 class="font-black text-base">${brick.name}</h4>
              <p class="text-xs text-secondary">${colorName} · <span class="inline-block w-3 h-3 rounded" style="background:${colorHex}"></span> ${colorHex}</p>
            </div>
          </div>`;
      } else {
        manualFields.style.display = 'contents';
        preview.style.display = 'none';
        preview.innerHTML = '';
      }
    });
  }

  const addForm = document.getElementById('add-brick-form');
  if (addForm) {
    addForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(addForm);
      const res = await fetch(`?set=${querySetNumber}`, { method: 'POST', body: formData });
      if (res.ok) {
        const html = await res.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, "text/html");
        const newList = doc.getElementById('brick-list');
        const currentList = document.getElementById('brick-list');
        if (newList && currentList) {
          currentList.innerHTML = newList.innerHTML;
        }
        addForm.reset();
        if (manualFields) manualFields.style.display = 'contents';
        if (preview) { preview.style.display = 'none'; preview.innerHTML = ''; }
      }
    });
  }
</script>
