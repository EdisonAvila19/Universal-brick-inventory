---
import AppLayout from "@layouts/AppLayout.astro";
import { getInventoryBricks, getInventorySets, updateBrickStock } from "@lib/inventoryStore";
import type { GroupedBrick } from "@data/archiveData";
import BrickInfo from '@components/brick-info.astro';

const createJsonResponse = (payload: Record<string, unknown>, status = 200) => {
  return new Response(JSON.stringify(payload), {
    status,
    headers: {
      "content-type": "application/json; charset=utf-8"
    }
  });
};

const url = new URL(Astro.request.url);
const pieceFilter = (url.searchParams.get("piece") ?? "").trim();
const setFilters = url.searchParams.getAll("set").map((value) => value.trim()).filter(Boolean);
const statusFilter = url.searchParams.get("status") ?? "all";

let feedback = "";
let feedbackTone: "ok" | "error" = "ok";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = String(formData.get("action") ?? "");
  const wantsJson =
    String(formData.get("responseType") ?? "") === "json" ||
    (Astro.request.headers.get("accept") ?? "").includes("application/json");

  if (action === "update-stock") {
    const elementId = String(formData.get("elementId") ?? "");
    if (!elementId) {
      if (wantsJson) {
        return createJsonResponse({ updated: false, message: "Invalid stock data." }, 400);
      }
      feedbackTone = "error";
      feedback = "Could not update stock for the selected piece.";
    } else {
      const allBricks = await getInventoryBricks();
      const instances = allBricks.filter((b) => b.elementId === elementId);
      let anyUpdated = false;

      const individualStockEntries = Array.from(formData.entries())
        .filter(([key]) => key.startsWith("stock_"))
        .map(([key, value]) => ({ fromSet: key.replace("stock_", ""), stock: Number(value) }));

      if (individualStockEntries.length > 0) {
        for (const entry of individualStockEntries) {
          const normalized = Number.isFinite(entry.stock) ? Math.max(0, Math.floor(entry.stock)) : 0;
          const instance = instances.find((b) => b.fromSet === entry.fromSet);
          if (instance) {
            const result = await updateBrickStock({ elementId, fromSet: entry.fromSet, stock: normalized });
            if (result.updated) anyUpdated = true;
          }
        }
      }

      if (wantsJson) {
        const bricks = await getInventoryBricks();
        const updatedInstances = bricks.filter((b) => b.elementId === elementId);
        const totalRequired = updatedInstances.reduce((acc, b) => acc + b.required, 0);
        const totalStock = updatedInstances.reduce((acc, b) => acc + b.stock, 0);
        const needed = Math.max(0, totalRequired - totalStock);
        const setStockMap = updatedInstances.map((b) => ({ fromSet: b.fromSet, stock: b.stock, required: b.required }));
        return createJsonResponse({
          updated: anyUpdated,
          message: anyUpdated ? "Stock updated successfully." : "Could not update stock for the selected piece.",
          totalRequired,
          totalStock,
          needed,
          setStockMap
        }, anyUpdated ? 200 : 404);
      }
      if (anyUpdated) {
        feedback = "Stock updated successfully.";
      } else {
        feedbackTone = "error";
        feedback = "Could not update stock for the selected piece.";
      }
    }
  }
}

const bricks = await getInventoryBricks();
const sets = await getInventorySets();

const brickGroups = new Map<string, (typeof bricks)[number][]>();
for (const brick of bricks) {
  const existing = brickGroups.get(brick.elementId);
  if (existing) {
    existing.push(brick);
  } else {
    brickGroups.set(brick.elementId, [brick]);
  }
}

const groupedBricks: GroupedBrick[] = [];
for (const [elementId, group] of brickGroups) {
  const first = group[0];
  const totalRequired = group.reduce((acc, b) => acc + b.required, 0);
  const totalStock = group.reduce((acc, b) => acc + b.stock, 0);
  const needed = Math.max(0, totalRequired - totalStock);
  groupedBricks.push({
    elementId: first.elementId,
    reference: first.reference,
    name: first.name,
    colorId: first.colorId,
    colorName: (first as Record<string, unknown>).colorName as string ?? "Unknown",
    colorHex: (first as Record<string, unknown>).colorHex as string ?? "#000000",
    image: first.image,
    totalRequired,
    totalStock,
    needed,
    sets: group.map((b) => ({ setNumber: b.fromSet, required: b.required, stock: b.stock }))
  });
}

const normalizedPieceFilter = pieceFilter.toLowerCase();
const filteredBricks = groupedBricks.filter((group) => {
  const matchesPiece = !normalizedPieceFilter || group.reference.toLowerCase().includes(normalizedPieceFilter) || group.name.toLowerCase().includes(normalizedPieceFilter) || group.elementId.toLowerCase().includes(normalizedPieceFilter);
  const matchesSet = setFilters.length === 0 || group.sets.some((s) => setFilters.includes(s.setNumber));
  const matchesStatus = statusFilter === "all" || (statusFilter === "missing" ? group.needed > 0 : group.needed === 0);
  return matchesPiece && matchesSet && matchesStatus;
});

const totalUniquePieces = groupedBricks.length;
const missingBricks = groupedBricks.reduce((acc, g) => acc + (g.needed > 0 ? 1 : 0), 0);
const setOptions = sets.map((set) => ({ label: `${set.setNumber} — ${set.name}`, value: set.setNumber }));
---

<AppLayout title="Bricks Inventory | Brick Inventory" active="bricks">
  <section class="mb-10 flex flex-col md:flex-row justify-between items-end gap-6">
    <div>
      <h1 class="text-4xl font-black tracking-tight mb-2">Brick Inventory</h1>
      <p class="text-secondary font-medium uppercase text-xs tracking-[0.2em]">Pieces and stock overview</p>
    </div>
    <div class="flex gap-12 text-right">
      <div class="flex flex-col"><span class="text-4xl font-black tracking-tighter">{totalUniquePieces}</span><span class="text-[10px] uppercase font-bold text-secondary tracking-widest">Total Unique Pieces</span></div>
      <div class="flex flex-col"><span id="missing-bricks-value" class="text-4xl font-black text-error tracking-tighter">{missingBricks}</span><span class="text-[10px] uppercase font-bold text-error tracking-widest">Missing Bricks</span></div>
    </div>
  </section>

  <p id="bricks-feedback" class:list={["mb-6 rounded-lg p-3 text-sm font-medium", feedback ? "" : "hidden", feedbackTone === "error" ? "bg-error-container text-on-error-container" : "bg-tertiary-container text-on-tertiary-container"]}>{feedback}</p>

  <form method="get" class="bg-surface-container-low p-6 rounded-xl mb-10 grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
    <div>
      <label class="block text-[10px] uppercase font-bold text-secondary mb-2 px-2">Piece Number or Name</label>
      <input class="w-full bg-surface-container-highest border-none rounded-lg px-4 py-3 text-sm" placeholder="e.g. 3001" type="text" name="piece" value={pieceFilter} />
    </div>
    <div>
      <label class="block text-[10px] uppercase font-bold text-secondary mb-2 px-2">Set Source</label>
      <select class="w-full h-[46px] bg-surface-container-highest border-none rounded-lg px-4 py-3 text-sm" name="set" multiple size="1">
        <option value="" selected={setFilters.length === 0}>All Sets</option>
        {setOptions.map((option) => <option value={option.value} selected={setFilters.includes(option.value)}>{option.label}</option>)}
      </select>
    </div>
    <div>
      <label class="block text-[10px] uppercase font-bold text-secondary mb-2 px-2">Status</label>
      <select class="w-full bg-surface-container-highest border-none rounded-lg px-4 py-3 text-sm" name="status">
        <option value="all" selected={statusFilter === "all"}>All</option>
        <option value="missing" selected={statusFilter === "missing"}>Missing</option>
        <option value="in-stock" selected={statusFilter === "in-stock"}>In Stock</option>
      </select>
    </div>
    <button type="submit" class="bg-on-surface text-white py-3 px-8 rounded-lg font-bold text-sm">Apply Filters</button>
  </form>

  {filteredBricks.length === 0 ? (
    <div class="text-center py-24 text-secondary">
      <h2 class="text-2xl font-black mb-2">No bricks found</h2>
      <p class="text-sm">Adjust filters or add a set via <a href="/add-set" class="text-primary font-bold">Catalog New Set</a>.</p>
    </div>
  ) : (
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      {filteredBricks.map((group) => (
        <BrickInfo brick={group} />      
      ))}
    </section>
  )}
  <script is:inline>
    const feedbackEl = document.getElementById("bricks-feedback");
    const missingBricksEl = document.getElementById("missing-bricks-value");
    const successClasses = ["bg-tertiary-container", "text-on-tertiary-container"];
    const errorClasses = ["bg-error-container", "text-on-error-container"];

    const setFeedback = (type, message) => {
      if (!feedbackEl) return;
      feedbackEl.classList.remove("hidden", ...successClasses, ...errorClasses);
      feedbackEl.classList.add(...(type === "success" ? successClasses : errorClasses));
      feedbackEl.textContent = message;
    };

    const recalculateMissingBricks = () => {
      if (!missingBricksEl) return;
      const total = Array.from(document.querySelectorAll("[data-needed-value]")).reduce((acc, el) => acc + (Number(el.textContent || "0") > 0 ? 1 : 0), 0);
      missingBricksEl.textContent = String(total);
    };

    const updateTotals = (card, setStockMap) => {
      if (!card) return;
      const stockValueEl = card.querySelector("[data-stock-value]");
      const neededValueEl = card.querySelector("[data-needed-value]");
      const requiredValueEl = card.querySelector("[data-required-value]");
      const statusPill = card.querySelector("[data-status-pill]");

      let totalStock = 0;
      let totalRequired = 0;
      if (setStockMap && Array.isArray(setStockMap)) {
        totalStock = setStockMap.reduce((acc, s) => acc + (Number(s.stock) || 0), 0);
        totalRequired = setStockMap.reduce((acc, s) => acc + (Number(s.required) || 0), 0);
      }
      const needed = Math.max(0, totalRequired - totalStock);

      if (stockValueEl) stockValueEl.textContent = String(totalStock);
      if (requiredValueEl) requiredValueEl.textContent = String(totalRequired);
      if (neededValueEl) neededValueEl.textContent = String(needed);

      if (statusPill) {
        statusPill.classList.remove("bg-error-container", "text-on-error-container", "bg-tertiary-container", "text-on-tertiary-container");
        if (needed > 0) {
          statusPill.classList.add("bg-error-container", "text-on-error-container");
          statusPill.textContent = "Missing";
        } else {
          statusPill.classList.add("bg-tertiary-container", "text-on-tertiary-container");
          statusPill.textContent = "In Stock";
        }
      }

      if (setStockMap && Array.isArray(setStockMap)) {
        for (const s of setStockMap) {
          const input = card.querySelector(`[data-stock-input="${s.fromSet}"]`);
          if (input) input.value = String(s.stock);
        }
      }
    };

    document.querySelectorAll("form[data-async-stock-form]").forEach((form) => {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const saveButton = form.querySelector("[data-save-button]");
        const card = form.closest("[data-brick-card]");
        const detailsEl = form.closest("details");
        const buttonText = saveButton?.textContent ?? "Save";

        if (saveButton) {
          saveButton.disabled = true;
          saveButton.textContent = "Saving...";
        }

        const stockInputs = card?.querySelectorAll("[data-stock-input]") || [];
        const formData = new FormData(form);
        for (const input of stockInputs) {
          const setNumber = input.getAttribute("data-stock-input");
          formData.set(`stock_${setNumber}`, String(input.value));
        }

        try {
          const response = await fetch(form.getAttribute("action") || window.location.href, {
            method: "POST",
            body: formData,
            headers: {
              Accept: "application/json"
            }
          });
          const payload = await response.json();
          if (!response.ok || !payload.updated) {
            setFeedback("error", payload.message || "Could not update stock for the selected piece.");
            return;
          }

          updateTotals(card, payload.setStockMap);
          recalculateMissingBricks();
          setFeedback("success", payload.message || "Stock updated successfully.");
          detailsEl?.removeAttribute("open");
        } catch {
          setFeedback("error", "Could not update stock for the selected piece.");
        } finally {
          if (saveButton) {
            saveButton.disabled = false;
            saveButton.textContent = buttonText;
          }
        }
      });
    });
  </script>
</AppLayout>
